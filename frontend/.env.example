# English Day (Flutter) settings. Copy to `.env` (not committed) and run with:
#   flutter run -d chrome --web-port 5000 --dart-define-from-file=.env
#   flutter build web --dart-define-from-file=.env
#
# These values are compiled INTO the app, so anyone with the app can read them.
# Never put secrets here (no AI/API keys): the AI key belongs in backend/.env only.

# Backend API address. Leave empty for the automatic default:
#   Chrome / Windows / iOS simulator -> http://localhost:8000/api/v1
#   Android emulator                 -> http://10.0.2.2:8000/api/v1
# Examples:
#   real phone on the same Wi-Fi:  API_BASE_URL=http://192.168.1.20:8000/api/v1
#   shared/staging server:         API_BASE_URL=https://api.example.com/api/v1
API_BASE_URL=

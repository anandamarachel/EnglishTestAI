# Local development only. Copy to .env and choose a password before starting PostgreSQL.
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
# Docker only. 127.0.0.1 keeps the API private to this computer (emulators still work).
# Set 0.0.0.0 to test from a real phone on the same Wi-Fi, and add this computer's
# LAN IP to ALLOWED_HOSTS below.
API_BIND=127.0.0.1
# Hostnames the API answers to. 10.0.2.2 is how the Android emulator reaches this computer.
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2","testserver"]
# Native Android does not require CORS. Add explicit web origins if a web client is introduced.
CORS_ORIGINS=[]

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=english_practice
POSTGRES_USER=english_app
POSTGRES_PASSWORD=replace-with-a-local-password
# Database connections per process (API and worker each). Defaults: 10 + 10 overflow, 15 s wait.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=15

# Signs access tokens. make setup generates a random value; use a server-managed
# secret of at least 32 random bytes in production and never commit it.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional overrides (defaults shown):
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# PASSWORD_MIN_LENGTH=8
# AUTH_RATE_LIMIT_ENABLED=true

# Private audio files. API and worker must see the same directory (Docker uses a
# shared volume). Never serve it statically; downloads go through the API.
# MEDIA_STORAGE_DIR=var/media
# LISTENING_VOICES=["female_1","male_1"]

# AI engine. Setting ROUTER_API_KEY switches the worker to the real AI (9router, an
# OpenAI-compatible gateway, plus Edge TTS) automatically. Without a key, development uses
# the stand-in (placeholder results) and production runs no AI. AI_PROVIDER=fake|router|none
# forces one. Restart after changes (make restart).
# AI_PROVIDER=router
# ROUTER_BASE_URL=https://9router.lecimangga.my.id/v1
# ROUTER_API_KEY=sk-...
# ROUTER_MODEL_GENERATE=gemini/gemini-3.8-flash
# ROUTER_MODEL_GRADE=gemini/gemini-3.1-pro-preview
# ROUTER_MODEL_CHAT=gemini/gemini-3.5-flash-lite
# ROUTER_MODEL_STT=gemini/gemini-3.5-flash-lite
# Real models (thinking, retries, TTS) need more than the default 120 s per job.
# AI_REQUEST_TIMEOUT_SECONDS=600
# Let the grade model listen to recordings for fluency/pronunciation (experimental).
# ROUTER_ASSESS_AUDIO=false
# Calls to 9router at once per process, and waits/retries after a rate limit (429/503).
# ROUTER_MAX_CONCURRENCY=4
# ROUTER_RATE_LIMIT_RETRIES=4

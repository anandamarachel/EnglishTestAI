# Local development only. Copy to .env and choose a password before starting PostgreSQL.
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Native Android does not require CORS. Add explicit web origins if a web client is introduced.
CORS_ORIGINS=[]

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=english_practice
POSTGRES_USER=english_app
POSTGRES_PASSWORD=replace-with-a-local-password
